#!/usr/bin/env bash
set -euo pipefail

LIGHT_DIR="${HOME}/.local/share/light-mode.d"
DARK_DIR="${HOME}/.local/share/dark-mode.d"
STATE_FILE="${HOME}/.cache/plasma-colorscheme-hook-state"

get_initial_mode() {
    local output
    output=$(gdbus call --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>/dev/null || true)

    case "$output" in
        *"uint32 1"*) echo "dark" ;;
        *"uint32 2"* | *"uint32 0"*) echo "light" ;;
    esac
}

parse_monitor_line() {
    local line="$1"
    if [[ "$line" != *"org.freedesktop.appearance"* ]] || [[ "$line" != *"color-scheme"* ]]; then
        return
    fi

    case "$line" in
        *"uint32 1"*) echo "dark" ;;
        *"uint32 2"* | *"uint32 0"*) echo "light" ;;
    esac
}

run_scripts() {
    local dir="$1"
    if [[ ! -d "$dir" ]]; then
        echo "Directory $dir does not exist, skipping." >&2
        return
    fi

    local script
    for script in "$dir"/*; do
        [[ -e "$script" ]] || continue
        [[ -f "$script" && -x "$script" ]] || continue
        echo "Executing: $script" >&2
        if ! "$script"; then
            echo "Warning: $script failed with exit code $?" >&2
        fi
    done
}

main() {
    local prev_mode=""
    local current_mode=""

    mkdir -p "$(dirname "$STATE_FILE")"

    if [[ -f "$STATE_FILE" ]]; then
        prev_mode=$(cat "$STATE_FILE")
    fi

    current_mode=$(get_initial_mode)
    if [[ -n "$current_mode" && "$current_mode" != "$prev_mode" ]]; then
        echo "Initial mode: $current_mode (state updated, scripts not run)" >&2
        echo "$current_mode" > "$STATE_FILE"
        prev_mode="$current_mode"
    fi

    echo "Monitoring color-scheme changes..." >&2

    gdbus monitor --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop | while IFS= read -r line; do

        local mode
        mode=$(parse_monitor_line "$line")
        [[ -n "$mode" ]] || continue

        echo "Detected mode: $mode" >&2

        if [[ "$mode" == "$prev_mode" ]]; then
            echo "Mode unchanged, skipping." >&2
            continue
        fi

        if [[ "$mode" == "dark" ]]; then
            run_scripts "$DARK_DIR"
        else
            run_scripts "$LIGHT_DIR"
        fi

        prev_mode="$mode"
        echo "$mode" > "$STATE_FILE"
    done

    echo "Monitor exited unexpectedly." >&2
    exit 1
}

main "$@"
