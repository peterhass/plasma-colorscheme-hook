#!/usr/bin/env bash
set -eu

LIGHT_DIR="${HOME}/.local/share/light-mode.d"
DARK_DIR="${HOME}/.local/share/dark-mode.d"
STATE_FILE="${HOME}/.cache/plasma-colorscheme-hook-state"
DRY_RUN=false

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]

Listen to xdg-desktop-portal color-scheme changes and run custom scripts
in ~/.local/share/light-mode.d/ and ~/.local/share/dark-mode.d/.

Options:
  -n, --dry-run   Print which scripts would be executed without running them.
  -h, --help      Show this help message and exit.
EOF
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                echo "Unknown option: $1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

get_initial_mode() {
    local output
    output=$(gdbus call --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.Settings.Read \
        org.freedesktop.appearance color-scheme 2>/dev/null || true)

    case "$output" in
        *"uint32 1"*) echo "dark" ;;
        *"uint32 2"* | *"uint32 0"*) echo "light" ;;
    esac
}

parse_monitor_line() {
    local line="$1"
    if [[ "$line" != *"org.freedesktop.appearance"* ]] || [[ "$line" != *"color-scheme"* ]]; then
        return
    fi

    case "$line" in
        *"uint32 1"*) echo "dark" ;;
        *"uint32 2"* | *"uint32 0"*) echo "light" ;;
    esac
}

run_scripts() {
    local dir="$1"
    local mode="$2"
    if [[ ! -d "$dir" ]]; then
        echo "Directory $dir does not exist, skipping." >&2
        return
    fi

    local script
    while IFS= read -r -d '' script; do
        [[ -x "$script" ]] || continue

        if [[ "$DRY_RUN" == true ]]; then
            echo "[dry-run] Would execute: $script $mode" >&2
        else
            echo "Executing: $script $mode" >&2
            if ! "$script" "$mode"; then
                echo "Warning: $script failed with exit code $?" >&2
            fi
        fi
    done < <(find "$dir" -maxdepth 1 \( -type f -o -type l \) -print0 | sort -z)
}

write_state() {
    local mode="$1"
    if [[ "$DRY_RUN" == true ]]; then
        echo "[dry-run] Would write state: $mode -> $STATE_FILE" >&2
    else
        echo "$mode" > "$STATE_FILE"
    fi
}

main() {
    parse_args "$@"

    local prev_mode=""
    local current_mode=""

    if [[ "$DRY_RUN" != true ]]; then
        mkdir -p "$(dirname "$STATE_FILE")"
    fi

    if [[ -f "$STATE_FILE" ]]; then
        prev_mode=$(cat "$STATE_FILE")
    fi

    current_mode=$(get_initial_mode)
    if [[ -n "$current_mode" && "$current_mode" != "$prev_mode" ]]; then
        echo "Initial mode: $current_mode (state updated, scripts not run)" >&2
        write_state "$current_mode"
        prev_mode="$current_mode"
    fi

    if [[ "$DRY_RUN" == true ]]; then
        echo "[dry-run] Current mode: ${current_mode:-unknown}" >&2
        echo "[dry-run] Scripts in $LIGHT_DIR (would run on light mode):" >&2
        run_scripts "$LIGHT_DIR" light
        echo "[dry-run] Scripts in $DARK_DIR (would run on dark mode):" >&2
        run_scripts "$DARK_DIR" dark
        return
    fi

    echo "Monitoring color-scheme changes..." >&2

    gdbus monitor --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop | while IFS= read -r line; do

        local mode
        mode=$(parse_monitor_line "$line")
        [[ -n "$mode" ]] || continue

        echo "Detected mode: $mode" >&2

        if [[ "$mode" == "$prev_mode" ]]; then
            echo "Mode unchanged, skipping." >&2
            continue
        fi

        if [[ "$mode" == "dark" ]]; then
            run_scripts "$DARK_DIR" dark
        else
            run_scripts "$LIGHT_DIR" light
        fi

        prev_mode="$mode"
        write_state "$mode"
    done

    echo "Monitor exited unexpectedly." >&2
    exit 1
}

main "$@"
